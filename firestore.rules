rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // User data — only the owning user can read/write their own data
    // -----------------------------------------------------------------------
    match /users/{userId} {

      // Only the authenticated user matching the userId can access their data
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      // Profile: owner read/write
      match /profile/{doc} {
        allow read, write: if isOwner();
      }

      // Preferences: owner read/write
      match /preferences/{doc} {
        allow read, write: if isOwner();
      }

      // Favorites: owner read/write, create with valid data
      match /favorites/{doc} {
        allow read, delete: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(['toolId', 'toolName', 'toolSlug', 'category', 'addedAt']);
      }

      // History: owner read/write, create with valid data
      match /history/{doc} {
        allow read, delete: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(['toolId', 'toolName', 'toolSlug', 'category', 'action', 'timestamp']);
      }

      // Legacy usage/credits docs: read-only for one release, then removed (blueprint section 25).
      // AI quota now lives server-side; clients can never write these.
      match /usage/{doc} {
        allow read: if isOwner();
        allow write: if false;
      }
      match /credits/{doc} {
        allow read: if isOwner();
        allow write: if false;
      }

      // Saved items: owner read/write
      match /saved/{doc} {
        allow read, delete: if isOwner();
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(['toolId', 'toolName', 'toolSlug', 'category', 'title', 'resultData', 'createdAt']);
      }

      // AI Conversations: owner read/write
      match /ai_conversations/{doc} {
        allow read, write: if isOwner();
      }
    }

    // Top-level AI Conversations fallback
    match /ai_conversations/{doc} {
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // Public collections — read-only for authenticated users
    // -----------------------------------------------------------------------
    match /publicTemplates/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // managed in the Firebase console only
    }

    match /publicTools/{doc} {
      allow read: if request.auth != null;
      allow write: if false; // managed in the Firebase console only
    }

    // -----------------------------------------------------------------------
    // Feedback — anyone can submit (validated); read only in the Firebase console
    // -----------------------------------------------------------------------
    match /feedback/{doc} {
      allow read, update, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['type', 'message', 'name', 'email', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.type in ['suggestion', 'bug', 'feedback', 'question']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new';
    }

    // -----------------------------------------------------------------------
    // Default deny
    // -----------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}